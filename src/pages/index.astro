---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Diagnosa from '~/components/livery/Diagnosa.astro';
import Odometer from '~/components/livery/Odometer.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Ulasan from '~/components/livery/Ulasan.astro';
import Faq from '~/components/livery/Faq.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import { bengkelPurwokerto } from '~/data/bisnis';
import { FAQ_SERVIS } from '~/data/faq';
import { WA_DARURAT, WA_GCU, waLink } from '~/data/diagnosa';

import workshopImg from '~/assets/images/uploads/IMG_6342-scaled.jpg';

const metadata = {
  title: 'Pitcar — Bengkel Mobil Purwokerto Terbaik & Terpercaya',
  ignoreTitleTemplate: true,
  description:
    'Pitcar bengkel mobil Purwokerto menawarkan 9+ layanan dalam 1 panggilan: service mesin, oli, AC, rem, transmisi, body repair, detailing, mobil Eropa, dan emergency 24 jam.',
  canonical: 'https://pitcar.co.id',
  keywords:
    'bengkel mobil purwokerto, pitcar, bengkel mobil terbaik purwokerto, bengkel mobil terpercaya purwokerto, bengkel mobil panggilan purwokerto, bengkel mobil 24 jam purwokerto, bengkel mobil Eropa purwokerto',
};

const layanan = [
  { slug: 'service-mesin', nama: 'Service Mesin', isi: 'Tune up mobil bensin dan diesel, purging, turun mesin (overhaul), servis radiator.' },
  { slug: 'ganti-oli', nama: 'Ganti Oli', isi: 'Shell, Mobil 1, Fastron, Castrol, TMO, Honda Genuine, dan merek lain sesuai kebutuhan mobil.' },
  { slug: 'scanning-ecu', nama: 'Scanning dan ECU', isi: 'Pendeteksian masalah elektrikal dengan scanner, perbaikan ECU, servis elektrikal.' },
  { slug: 'rem-kaki-kaki', nama: 'Rem dan Kaki-Kaki', isi: 'Servis rem, bubut disc brake, penggantian kampas rem, rekondisi shockbreaker.' },
  { slug: 'service-ac', nama: 'Service AC', isi: 'Perawatan AC, flushing, perbaikan kebocoran, pengisian freon, turun dashboard.' },
  { slug: 'transmisi-matic', nama: 'Transmisi', isi: 'Perbaikan ringan sampai berat untuk transmisi manual dan matic: AT, CVT, DCT, DSG.' },
  { slug: 'body-repair-detailing', nama: 'Body Repair dan Detailing', isi: 'Perbaikan bodi, cat full body, poles, serta detailing interior, eksterior, dan mesin.' },
  { slug: 'mobil-eropa', nama: 'Mobil Eropa dan Amerika', isi: 'BMW, Mercedes-Benz, Volkswagen, Audi, MINI, Porsche, Renault, Peugeot, Ford, Chevrolet, Jeep.' },
];

const cara = [
  { nama: 'Home Service', isi: 'Mekanik datang ke rumah atau kantor Anda.' },
  { nama: 'Pick Up Service', isi: 'Mobil dijemput, dikerjakan di workshop, lalu diantar kembali.' },
  { nama: 'Workshop', isi: 'Anda datang langsung ke bengkel Pitcar.' },
];

const alur = [
  { nama: 'Konsultasi dan booking', isi: 'Anda menghubungi admin untuk konsultasi, booking, atau panggilan darurat.' },
  { nama: 'Estimasi dan penawaran', isi: 'Admin memberi estimasi dari hasil konsultasi dan menyarankan layanan yang sesuai.' },
  { nama: 'Datang, home service, atau pick up', isi: 'Mekanik Pitcar melakukan general check-up dan pengerjaan pada mobil Anda.' },
  { nama: 'Pekerjaan selesai', isi: 'Untuk Pick Up Service, mobil diantar kembali setelah selesai.' },
  { nama: 'Pembayaran', isi: 'Admin mengirim nota. Bayar tunai atau transfer.' },
];

const waMitra = waLink('Halo Admin, saya tertarik dengan program kemitraan Pitcar. Mohon informasinya.');
---

<Layout metadata={metadata}>
  <JsonLd data={bengkelPurwokerto} />
  <Diagnosa />

  <Odometer />

  <section class="lv-sec lv-sec--seam" id="layanan" aria-labelledby="layanan-judul">
    <div class="lv-wrap">
      <h2 class="lv-h2" id="layanan-judul">Bengkel mobil Purwokerto untuk 9+ jenis pekerjaan</h2>
      <p class="lv-lead">Satu nomor admin untuk semua urusan mobil, dari ganti oli sampai turun mesin.</p>

      <div class="lv-sos lv-on-red">
        <div>
          <h3>Emergency 24 jam</h3>
          <p>Mogok atau bermasalah di jalan, jam berapa pun. Kirim lokasi Anda ke admin.</p>
        </div>
        <a class="lv-btn lv-btn--invert" href={WA_DARURAT} target="_blank" rel="noopener noreferrer">
          <Icon name="tabler:brand-whatsapp" aria-hidden="true" />
          Kirim lokasi darurat
        </a>
      </div>

      <ul class="lv-services">
        {
          layanan.map((l) => (
            <li>
              <h3>
                <a href={`/layanan/${l.slug}`}>{l.nama}</a>
              </h3>
              <p>{l.isi}</p>
            </li>
          ))
        }
      </ul>
      <p class="lv-sec__foot">
        <a class="lv-link" href="/layanan">Lihat rincian semua layanan</a>
      </p>
    </div>
  </section>

  <section class="lv-proof" aria-labelledby="bukti-judul">
    <div class="lv-proof__photo">
      <Image
        src={workshopImg}
        alt="Suasana workshop Pitcar Service"
        widths={[480, 768, 1200]}
        sizes="(max-width: 899px) 100vw, 52vw"
        loading="lazy"
      />
    </div>
    <div class="lv-proof__body">
      <h2 class="lv-proof__fact" id="bukti-judul">
        Sejak 2019, <b>18.953+</b> mobil sudah ditangani Pitcar. Sekarang <b>450+</b> unit per bulan di <b>5+</b> cabang, termasuk yang baru di Purbalingga, Tegal, dan Batam.
      </h2>
      <ul class="lv-ways">
        {
          cara.map((c) => (
            <li>
              <strong>{c.nama}</strong>
              <span>{c.isi}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lv-sec" aria-labelledby="alur-judul">
    <div class="lv-wrap">
      <h2 class="lv-h2" id="alur-judul">Dari chat sampai mobil kembali</h2>
      <ol class="lv-steps">
        {
          alur.map((a) => (
            <li>
              <strong>{a.nama}</strong>
              <span>{a.isi}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Ulasan />

  <section class="lv-sec" aria-labelledby="mitra-judul">
    <div class="lv-wrap lv-mitra">
      <div>
        <h2 class="lv-h2" id="mitra-judul">Buka bengkel Pitcar di kota Anda</h2>
        <p class="lv-lead">
          Program kemitraan Pitcar terbuka untuk Anda yang ingin membangun bengkel dengan sistem manajemen yang sudah berjalan di
          cabang-cabang kami.
        </p>
      </div>
      <div class="lv-close__acts">
        <a class="lv-btn" href="/kemitraan">Pelajari program kemitraan</a>
        <a class="lv-btn lv-btn--ghost" href={waMitra} target="_blank" rel="noopener noreferrer">Tanya admin kemitraan</a>
      </div>
    </div>
  </section>

  <div class="lv-blog">
  <BlogLatestPosts
      title="Info dan tips perawatan mobil"
      linkText="Semua artikel"
      information="Artikel dari tim mekanik Pitcar Service Purwokerto tentang cara merawat mobil Anda."
    />
  </div>

  <section class="lv-sec lv-sec--seam" aria-labelledby="faq-judul">
    <div class="lv-wrap">
      <h2 class="lv-h2" id="faq-judul">Yang sering ditanyakan</h2>
      <Faq items={FAQ_SERVIS} name="faq-servis" />
    </div>
  </section>

  <section class="lv-close lv-on-red" aria-labelledby="gcu-judul">
    <div class="lv-wrap">
      <h2 id="gcu-judul">Free General Check Up</h2>
      <p>Gratis untuk 5 mobil setiap hari. Booking slot Anda lewat admin sebelum kondisi mobil memburuk.</p>
      <div class="lv-close__acts">
        <a class="lv-btn lv-btn--invert" href={WA_GCU} target="_blank" rel="noopener noreferrer">
          <Icon name="tabler:brand-whatsapp" aria-hidden="true" />
          Booking check-up gratis
        </a>
        <a class="lv-btn lv-btn--line" href="#diagnosa">Cek gejala mobil dulu</a>
      </div>
    </div>
  </section>
</Layout>
