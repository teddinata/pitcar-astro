---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/livery/PageHead.astro';
import Closing from '~/components/livery/Closing.astro';
import Ulasan from '~/components/livery/Ulasan.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import { WA_DARURAT, WA_UMUM, waLink } from '~/data/diagnosa';
import { CABANG, mapsUrl, waCabang } from '~/data/jaringan';
import { bengkelPurwokerto } from '~/data/bisnis';

const metadata = {
  title: 'Pusat Bantuan & Kontak',
  description: 'Hubungi Pitcar Service - Bengkel Mobil Purwokerto. Konsultasi gratis dan booking layanan.',
  canonical: 'https://pitcar.co.id/hubungi-kami',
  robots: { index: true, follow: true },
  openGraph: {
    type: 'website',
  },
};

const PURWOKERTO = CABANG.find((c) => c.id === 'purwokerto')!;
const PETA = mapsUrl(PURWOKERTO);
const WA_BOOKING = waLink('Halo Pitcar, saya ingin booking jadwal servis.\nMobil & tahun:\nKeluhan:\n#booking-web');
---

<Layout metadata={metadata}>
  <JsonLd data={bengkelPurwokerto} />
  <PageHead
    crumb="Pusat bantuan"
    title="Hubungi Pitcar"
    lead="Konsultasi keluhan mobil, estimasi biaya, dan booking jadwal dilayani admin lewat WhatsApp."
  >
    <a class="lv-btn lv-btn--invert" href={WA_UMUM} target="_blank" rel="noopener noreferrer">
      <Icon name="tabler:brand-whatsapp" aria-hidden="true" />
      Chat admin di WhatsApp
    </a>
    <a class="lv-btn lv-btn--line" href={WA_DARURAT} target="_blank" rel="noopener noreferrer">Darurat 24 jam</a>
  </PageHead>

  <section class="lv-sec">
    <div class="lv-wrap lv-split">
      <div class="lv-block">
        <h2>Workshop Purwokerto</h2>
        <p>Bawa mobil Anda langsung ke bengkel untuk diperiksa.</p>
        <address class="lv-address">
          Jl. Pancurawis no. 14<br />
          Purwokerto Selatan<br />
          Banyumas, Jawa Tengah 53147<br />
          <a href="tel:+6285866224051">0858-6622-4051</a>
        </address>
        <div class="lv-close__acts">
          <a class="lv-btn" href={waCabang(PURWOKERTO, 'kontak')} target="_blank" rel="noopener noreferrer">
            <Icon name="tabler:brand-whatsapp" aria-hidden="true" />
            Chat cabang Purwokerto
          </a>
          <a class="lv-btn lv-btn--ghost" href={PETA} target="_blank" rel="noopener noreferrer">Buka di Google Maps</a>
        </div>
      </div>

      <div class="lv-block" id="cabang">
        <h2>Cabang dan toko Pitcar</h2>
        <p>Pilih cabang terdekat. Chat langsung terkirim dengan nama cabangnya, jadi admin bisa meneruskan ke tim yang tepat.</p>
        <ul class="lv-branches">
          {
            CABANG.filter((c) => c.id !== 'purwokerto').map((c) => (
              <li>
                <div class="lv-branches__name">
                  <strong>{c.nama}</strong>
                  {c.baru && <span class="lv-net__new">Baru</span>}
                  <small>{c.jenis === 'toko' ? 'Toko' : 'Bengkel'}</small>
                </div>
                <div class="lv-branches__acts">
                  <a class="lv-link" href={waCabang(c, 'kontak')} target="_blank" rel="noopener noreferrer">
                    Chat<span class="sr-only"> {c.nama}</span>
                  </a>
                  {c.maps && (
                    <a class="lv-link" href={mapsUrl(c)} target="_blank" rel="noopener noreferrer">
                      Peta<span class="sr-only"> {c.nama}</span>
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Ulasan />

  <Closing
    title="Booking jadwal servis"
    text="Kirim tipe mobil dan keluhannya. Admin mencarikan jadwal dan cara pengerjaan yang cocok."
    href={WA_BOOKING}
    label="Booking lewat WhatsApp"
  />
</Layout>
