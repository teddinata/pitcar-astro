---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/livery/PageHead.astro';
import Closing from '~/components/livery/Closing.astro';
import { WA_UMUM } from '~/data/diagnosa';
import timImg from '~/assets/images/uploads/owner-pitcar.jpg';
import sadamImg from '~/assets/images/uploads/Sadam-CO-e1673015745245.png';
import ilmanImg from '~/assets/images/uploads/Ilman-CO-e1673015703806.png';

const metadata = {
  title: 'Tentang Kami',
  description: 'Tentang Pitcar Service - Bengkel Mobil Purwokerto. One Stop Service untuk perawatan dan perbaikan mobil.',
  canonical: 'https://pitcar.co.id/tentang',
  robots: { index: true, follow: true },
  openGraph: {
    type: 'website',
  },
};

const misi = [
  { nama: 'Customer centric', isi: 'Layanan perawatan mobil yang berpusat pada kenyamanan dan kepuasan pelanggan.' },
  { nama: 'Kualitas dengan harga bersahabat', isi: 'Standar pengerjaan yang tinggi dengan harga yang tetap terjangkau.' },
  { nama: 'Kemudahan', isi: 'Home Service, Emergency 24 Jam, dan One Stop Service dalam satu nomor.' },
  { nama: 'Pemberdayaan talenta', isi: 'Mendidik talenta lokal menjadi mekanik dengan dua pegangan: good skill dan good attitude.' },
];

const pendiri = [
  { nama: "Ilman Naafi'an", peran: 'Co-Founder, Teknik Dirgantara ITB 2014', foto: ilmanImg },
  { nama: 'Sadam Saputra Al-Kaff', peran: 'Co-Founder, Teknik Pertambangan ITB 2014', foto: sadamImg },
];

const jejak = [
  { tahun: '2021', judul: 'Februari: berdiri saat pandemi', isi: 'Pitcar Service didirikan di tengah pandemi Covid-19 sebagai layanan perawatan mobil di rumah, tanpa perlu antre di bengkel.' },
  { tahun: '2021', judul: 'Oktober: bengkel pusat', isi: 'Pitcar merekrut mekanik tetap dan membangun bengkel di Jl. Pancurawis no. 14, Purwokerto Selatan.' },
  { tahun: '2022', judul: 'Juli: 5 startup Betalist Telkom', isi: 'Pitcar terpilih sebagai satu dari 5 startup Betalist Telkom nasional dan diundang pitching di Telkom Landmark Tower, Jakarta.' },
  { tahun: '2022', judul: 'Agustus: layanan darurat', isi: 'Pelanggan tetap mencapai 350 lebih di Purwokerto dan sekitarnya. Pitcar meluncurkan Emergency Home Service 24 jam dan layanan khusus mobil Eropa dan Amerika.' },
  { tahun: '2023', judul: 'Pindah ke Cloud ERP', isi: 'Stok part, riwayat servis, keuangan, data mekanik, manajemen proyek, dan marketing dicatat dalam satu sistem.' },
  { tahun: '2024', judul: '400 sampai 450 unit per bulan', isi: 'Kapasitas penerimaan servis dan perawatan mencapai rata-rata 400 sampai 450 unit setiap bulan.' },
  { tahun: '2025', judul: 'Cabang kedua dan lini sparepart', isi: 'Pitcar membuka Otokits by Pitcar di Cilacap, lalu mendirikan Pitcar Autopart dan Pitcar Auto Accessories.' },
];
---

<Layout metadata={metadata}>
  <PageHead
    crumb="Tentang"
    title="Tentang Pitcar"
    lead="Bengkel mobil dari Purwokerto yang dimulai sebagai layanan servis di rumah."
  />

  <section class="lv-proof">
    <div class="lv-proof__photo">
      <Image src={timImg} alt="Tim mekanik dan manajemen Pitcar" widths={[480, 768, 1200]} sizes="(max-width: 899px) 100vw, 52vw" />
    </div>
    <div class="lv-proof__body">
      <h2 class="lv-proof__fact">Visi</h2>
      <p class="lv-proof__text">
        Menjadi ekosistem perawatan mobil terbaik di Indonesia dengan mengedepankan kepuasan pelanggan, pelayanan prima, serta
        kemauan untuk terus berkembang bersama demi memberi dampak positif kepada keluarga Pitcar, mitra, dan masyarakat luas.
      </p>
    </div>
  </section>

  <section class="lv-sec">
    <div class="lv-wrap">
      <h2 class="lv-h2">Misi</h2>
      <ul class="lv-services">
        {
          misi.map((m) => (
            <li>
              <h3>{m.nama}</h3>
              <p>{m.isi}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lv-sec lv-sec--seam">
    <div class="lv-wrap">
      <h2 class="lv-h2">Pendiri</h2>
      <div class="lv-people">
        {
          pendiri.map((p) => (
            <figure class="lv-person">
              <Image src={p.foto} alt={p.nama} width={224} height={264} loading="lazy" />
              <figcaption>
                {p.nama}
                <span>{p.peran}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lv-sec lv-sec--seam">
    <div class="lv-wrap">
      <h2 class="lv-h2">Perjalanan Pitcar</h2>
      <ol class="lv-years">
        {
          jejak.map((j) => (
            <li>
              <time datetime={j.tahun}>{j.tahun}</time>
              <div>
                <strong>{j.judul}</strong>
                <p>{j.isi}</p>
              </div>
            </li>
          ))
        }
        <li>
          <time>Kini</time>
          <div>
            <strong>Purbalingga, Tegal, dan Batam</strong>
            <p>Pitcar membuka cabang baru di tiga kota ini, menyusul Purwokerto dan Cilacap.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <Closing
    title="Ada yang ingin ditanyakan?"
    text="Admin Pitcar menjawab pertanyaan soal layanan, cabang, dan jadwal servis lewat WhatsApp."
    href={WA_UMUM}
    label="Chat admin di WhatsApp"
  />
</Layout>
