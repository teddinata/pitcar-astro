---
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/livery/PageHead.astro';
import Closing from '~/components/livery/Closing.astro';
import { WA_DARURAT, WA_UMUM } from '~/data/diagnosa';
import { LAYANAN } from '~/data/layanan';

const metadata = {
  title: 'Layanan Servis & Perawatan Umum',
  description:
    'Layanan bengkel mobil Pitcar Purwokerto: service mesin, oli, scanning & ECU, rem & kaki-kaki, AC, transmisi, body repair, detailing, mobil Eropa, dan emergency 24 jam.',
  canonical: 'https://pitcar.co.id/layanan',
  robots: { index: true, follow: true },
  openGraph: {
    type: 'website',
  },
};

const layanan = LAYANAN;
---

<Layout metadata={metadata}>
  <PageHead
    crumb="Layanan"
    title="Layanan servis dan perawatan"
    lead="Dari servis berkala sampai turun mesin, dikerjakan di workshop, di rumah Anda, atau lewat Pick Up Service."
  >
    <a class="lv-btn lv-btn--invert" href={WA_UMUM} target="_blank" rel="noopener noreferrer">Konsultasi keluhan mobil</a>
    <a class="lv-btn lv-btn--line" href={WA_DARURAT} target="_blank" rel="noopener noreferrer">Darurat 24 jam</a>
  </PageHead>

  <section class="lv-sec">
    <div class="lv-wrap">
      <ul class="lv-cat">
        {
          layanan.map((l) => (
            <li>
              <div>
                <h2>
                  <a href={`/layanan/${l.slug}`}>{l.nama}</a>
                </h2>
                <p>{l.ringkas}</p>
                <a class="lv-link" href={`/layanan/${l.slug}`}>
                  Rincian<span class="sr-only"> {l.nama.toLowerCase()}</span>
                </a>
              </div>
              <ul class="lv-ticks">
                {l.rinci.map((r) => (
                  <li>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="lv-sec__foot">
        <a class="lv-link" href="/#diagnosa">Belum tahu masalahnya? Cek gejala mobil Anda</a>
      </p>
    </div>
  </section>

  <Closing
    title="Ceritakan keluhan mobil Anda"
    text="Admin menjelaskan kemungkinan kerusakan dan memberi estimasi sebelum pengerjaan."
    href={WA_UMUM}
    label="Chat admin di WhatsApp"
  />
</Layout>
