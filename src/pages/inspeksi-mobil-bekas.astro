---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/livery/PageHead.astro';
import Closing from '~/components/livery/Closing.astro';
import { waLink } from '~/data/diagnosa';
import workshopImg from '~/assets/images/uploads/IMG_6348-scaled.jpg';

const metadata = {
  title: 'Inspeksi Mobil Bekas Purwokerto',
  description:
    'Jasa full inspeksi mobil bekas dari PITCAR Service. Kami membantu Anda memeriksa 6 kategori pengecekan agar tidak was-was saat membeli mobil bekas.',
  robots: { index: true, follow: true },
  canonical: 'https://pitcar.co.id/inspeksi-mobil-bekas',
  keywords: 'inspeksi mobil bekas, inspeksi mobil bekas purwokerto',
};

const WA_INSPEKSI = waLink(
  'Permisi admin, mau tanya untuk jasa inspeksi mobil bekas di Purwokerto dan sekitarnya apa masih bisa?\nMobil yang mau dicek:\nLokasi mobil:\n#inspeksi-web'
);

const cek = [
  { nama: 'Scanning OBD', isi: 'Membaca catatan kerusakan di komputer mobil, sensor kelistrikan, dan riwayat mesin.' },
  { nama: 'Visual dan bodi', isi: 'Mencari bekas tabrakan dan perbaikan, kondisi sasis, serta mengukur ketebalan cat.' },
  { nama: 'Mesin', isi: 'Mendengar suara kasar di dalam mesin, mencari kebocoran oli, dan mengecek kompresi.' },
  { nama: 'Interior', isi: 'Mencari bau apak dan noda karat di sela karpet, tanda mobil pernah terendam banjir.' },
  { nama: 'Keabsahan surat', isi: 'Mencocokkan nomor rangka dan nomor mesin dengan BPKB dan STNK.' },
  { nama: 'Kaki-kaki', isi: 'Menguji understeel, suspensi, tie rod, dan rak kemudi yang rentan aus.' },
];

const tahap = [
  { nama: 'Booking tim inspeksi', isi: 'Anda menghubungi admin lewat WhatsApp untuk konfirmasi biaya, lokasi mobil, dan jadwal.' },
  { nama: 'Inspektor datang ke lokasi', isi: 'Mekanik mendatangi mobil incaran Anda membawa scanner dan peralatan sesuai jam yang disepakati.' },
  { nama: 'Hasil dan rekomendasi', isi: 'Anda menerima laporan hasil cek apa adanya, berikut rekomendasi mekanik sebagai bahan menawar harga.' },
];
---

<Layout metadata={metadata}>
  <PageHead
    crumb="Inspeksi mobil bekas"
    title="Was-was beli mobil bekas?"
    lead="Tim Pitcar mengecek kondisi teknis mobil incaran Anda di lokasinya, sebelum Anda membayar."
  >
    <a class="lv-btn lv-btn--invert" href={WA_INSPEKSI} target="_blank" rel="noopener noreferrer">Tanya jadwal inspeksi</a>
  </PageHead>

  <section class="lv-sec">
    <div class="lv-wrap">
      <h2 class="lv-h2">6 hal yang dicek</h2>
      <ul class="lv-services">
        {
          cek.map((c) => (
            <li>
              <h3>{c.nama}</h3>
              <p>{c.isi}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lv-proof">
    <div class="lv-proof__photo">
      <Image
        src={workshopImg}
        alt="Mekanik Pitcar memeriksa mobil di workshop"
        widths={[480, 768, 1200]}
        sizes="(max-width: 899px) 100vw, 52vw"
        loading="lazy"
      />
    </div>
    <div class="lv-proof__body">
      <h2 class="lv-proof__fact">Tahapan inspeksi</h2>
      <ol class="lv-ways">
        {
          tahap.map((t) => (
            <li>
              <strong>{t.nama}</strong>
              <span>{t.isi}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Closing
    id="booking"
    title="Konsultasi sebelum membeli"
    text="Punya mobil bekas incaran? Kirim tipe dan lokasinya ke admin. Biaya inspeksi dikonfirmasi lewat chat."
    href={WA_INSPEKSI}
    label="Chat admin soal inspeksi"
  />
</Layout>
