---
import Layout from '~/layouts/PageLayout.astro';
import { WA_UMUM } from '~/data/diagnosa';

const title = 'Halaman tidak ditemukan';
---

<Layout metadata={{ title }}>
  <section class="lv-head lv-on-red lv-404">
    <div class="lv-wrap">
      <h1>Halaman ini tidak ada</h1>
      <p>Alamatnya mungkin salah ketik atau halamannya sudah dipindah. Kembali ke beranda, atau langsung tanya admin.</p>
      <div class="lv-head__acts">
        <a class="lv-btn lv-btn--invert" href="/">Ke beranda</a>
        <a class="lv-btn lv-btn--line" href={WA_UMUM} target="_blank" rel="noopener noreferrer">Chat admin di WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>
