---
import JsonLd from '~/components/seo/JsonLd.astro';

export interface Props {
  title: string;
  lead?: string;
  crumb: string;
  /** Extra levels between Beranda and the current page. */
  trail?: { label: string; href: string }[];
}

const { title, lead, crumb, trail = [] } = Astro.props;
const site = 'https://pitcar.co.id';
const here = new URL(Astro.url.pathname, site).href;
---

<section class="lv-head lv-on-red">
  <div class="lv-wrap">
    <nav aria-label="Lokasi halaman">
      <ol class="lv-crumb">
        <li><a href="/">Beranda</a></li>
        {trail.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <div class="lv-head__acts"><slot /></div>
  </div>
</section>

<JsonLd
  data={{
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'Beranda', href: '/' }, ...trail, { label: crumb, href: here }].map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.label,
      item: new URL(t.href, site).href,
    })),
  }}
/>
