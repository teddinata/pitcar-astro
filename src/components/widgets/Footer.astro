---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';
import { Image } from 'astro:assets';
import logoPitcar from '~/assets/images/logo-pitcar.png';
import autoAccDark from '~/assets/images/LOGO PITCAR AUTOACC HITAM.png';
import autoAccLight from '~/assets/images/LOGO PITCAR AUTOACC PUTIH.png';
import autoPartDark from '~/assets/images/LOGO PITCAR AUTOPART HITAM.png';
import autoPartLight from '~/assets/images/LOGO PITCAR AUTOPART PUTIH.png';
import otokitsLogo from '~/assets/images/LOGO OTOKITSXPITCAR 2.png';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'lv-footer relative not-prose']}>
  <div class="lv-wrap relative z-10">
    <div class="grid grid-cols-12 gap-8 py-12 md:py-16 text-left">
      
      <!-- Brand & Logos Column -->
      <div class="col-span-12 lg:col-span-5 pr-0 xl:pr-8 mb-8 lg:mb-0">
         <div class="mb-6 inline-block">
           <a href={getHomePermalink()} class="inline-block">
             <Image src={logoPitcar} alt="Pitcar Service" class="lv-footer__logo h-10 md:h-12 w-auto" />
           </a>
         </div>
         <p class="lv-footer__muted text-sm md:text-base leading-relaxed mb-8 max-w-md">
           Pitcar Service, bengkel mobil Purwokerto dan Cilacap. Home Service, Pick Up Service, dan Workshop, termasuk darurat 24 jam.
         </p>
         <address class="lv-footer__addr not-italic mb-8">
           <span class="lv-footer__title block mb-2">Workshop Purwokerto</span>
           Jl. Pancurawis no. 14, Purwokerto Selatan<br />
           Banyumas, Jawa Tengah 53147<br />
           <a class="lv-footer__link inline-block py-2" href="tel:+6285866224051">0858-6622-4051</a>
           <span aria-hidden="true"> · </span>
           <a class="lv-footer__link inline-block py-2" href="/hubungi-kami#cabang">Cabang lain</a>
         </address>
         
         <div class="mb-6">
           <p class="lv-footer__title mb-4">Ekosistem Pitcar</p>
           <div class="flex flex-wrap items-center gap-6">
             <!-- Otokits -->
             <Image src={otokitsLogo} alt="Otokits" class="lv-family__chip h-7 md:h-8 w-auto" />
             
             <!-- Auto Accessories -->
             <div class="relative group h-7 md:h-8 flex items-center">
                 <Image src={autoAccDark} alt="Auto Accessories" class="h-7 md:h-8 w-auto block dark:hidden " />
                 <Image src={autoAccLight} alt="Auto Accessories" class="h-7 md:h-8 w-auto hidden dark:block " />
             </div>
             
             <!-- Auto Part -->
             <div class="relative group h-7 md:h-8 flex items-center">
                 <Image src={autoPartDark} alt="Auto Part" class="h-7 md:h-8 w-auto block dark:hidden " />
                 <Image src={autoPartLight} alt="Auto Part" class="h-7 md:h-8 w-auto hidden dark:block " />
             </div>
           </div>
         </div>
      </div>
      
      <!-- Links Columns -->
      <div class="col-span-12 lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8 sm:gap-8">
      {
        links.map(({ title, links }) => (
          <div>
            <p class="lv-footer__title mb-4">{title}</p>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="space-y-1 text-[0.9375rem]">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="lv-footer__link inline-block py-2"
                      href={href}
                      aria-label={ariaLabel}
                      set:html={text}
                    />
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
      </div>
    </div>
    
    <!-- Footer Bottom -->
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-slate-200 dark:border-white/10 mt-4 md:mt-0">
      <div class="lv-footer__muted text-sm mr-4 mb-4 md:mb-0 flex flex-wrap items-center gap-2">
        <Fragment set:html={footNote} />
        {
          secondaryLinks.map(({ text, href }) => (
            <>
              <span class="text-slate-300 dark:text-white/20 hidden sm:inline">|</span>
              <a
                class="lv-footer__link underline"
                href={href}
                set:html={text}
              />
            </>
          ))
        }
      </div>
      
      {
        socialLinks?.length ? (
          <ul class="flex md:order-1 -ml-2 md:ml-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="lv-footer__link text-sm p-3 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {icon && <Icon name={icon} class="w-5 h-6" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }
    </div>
  </div>
</footer>
