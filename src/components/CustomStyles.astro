---
import '@fontsource-variable/inter';
import '@fontsource/chakra-petch/latin-600.css';
import '@fontsource/chakra-petch/latin-700.css';
import '@fontsource/chakra-petch/latin-700-italic.css';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Chakra Petch', 'Inter Variable';

    --aw-color-primary: rgb(204 0 0);
    --aw-color-secondary: rgb(163 0 0);
    --aw-color-accent: rgb(204 0 0);

    --aw-color-text-heading: rgb(17 17 18);
    --aw-color-text-default: rgb(17 17 18);
    --aw-color-text-muted: rgb(74 76 82);
    --aw-color-bg-page: rgb(243 243 243);

    --aw-color-bg-page-dark: rgb(15 15 16);
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Chakra Petch', 'Inter Variable';

    --aw-color-primary: rgb(204 0 0);
    --aw-color-secondary: rgb(163 0 0);
    --aw-color-accent: rgb(204 0 0);

    --aw-color-text-heading: rgb(243 243 243);
    --aw-color-text-default: rgb(243 243 243);
    --aw-color-text-muted: rgb(169 171 177);
    --aw-color-bg-page: rgb(15 15 16);
  }
</style>

