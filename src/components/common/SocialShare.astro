---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;

const targets = [
  { id: 'whatsapp', label: 'Bagikan ke WhatsApp', icon: 'tabler:brand-whatsapp' },
  { id: 'facebook', label: 'Bagikan ke Facebook', icon: 'tabler:brand-facebook' },
  { id: 'twitter', label: 'Bagikan ke X', icon: 'tabler:brand-x' },
  { id: 'linkedin', label: 'Bagikan ke LinkedIn', icon: 'tabler:brand-linkedin' },
  { id: 'mail', label: 'Kirim lewat email', icon: 'tabler:mail' },
];
---

<div class={className}>
  <p class="lv-share__label">Bagikan</p>
  <ul class="lv-share__list">
    {
      targets.map((t) => (
        <li>
          <button
            type="button"
            class="lv-share__btn"
            title={t.label}
            aria-label={t.label}
            data-aw-social-share={t.id}
            data-aw-url={url}
            data-aw-text={text}
          >
            <Icon name={t.icon} aria-hidden="true" />
          </button>
        </li>
      ))
    }
  </ul>
</div>
