---
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Artikel lebih baru', nextText = 'Artikel lebih lama' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <nav class="lv-pager" aria-label="Halaman artikel">
      {prevUrl ? (
        <a class="lv-btn lv-btn--ghost" href={getPermalink(prevUrl)} rel="prev">
          <Icon name="tabler:chevron-left" aria-hidden="true" />
          {prevText}
        </a>
      ) : (
        <span />
      )}
      {nextUrl && (
        <a class="lv-btn lv-btn--ghost" href={getPermalink(nextUrl)} rel="next">
          {nextText}
          <Icon name="tabler:chevron-right" aria-hidden="true" />
        </a>
      )}
    </nav>
  )
}
