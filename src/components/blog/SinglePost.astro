---
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import PageHead from '~/components/livery/PageHead.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import Closing from '~/components/livery/Closing.astro';
import { waLink } from '~/data/diagnosa';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;

const namaKategori = (t: string) => { const s = t.replaceAll('-', ' '); return s.charAt(0).toUpperCase() + s.slice(1); };

const trail = [
  { label: 'Jurnal otomotif', href: getBlogPermalink() },
  ...(post.category ? [{ label: namaKategori(post.category.title), href: getPermalink(post.category.slug, 'category') }] : []),
];

const waArtikel = waLink(`Halo Pitcar, saya baca artikel "${post.title}" dan mau konsultasi.\nMobil & tahun:\nKeluhan:\n#artikel-web`);
---

<PageHead title={post.title} crumb={post.title} trail={trail}>
  <p class="lv-post__meta">
    <time datetime={new Date(post.publishDate).toISOString()}>{getFormattedDate(post.publishDate)}</time>
    {post.readingTime && <span>{post.readingTime} menit baca</span>}
    {post.author && <span>{post.author.replaceAll('-', ' ')}</span>}
  </p>
</PageHead>

<article class="lv-sec lv-post">
  <div class="lv-wrap">
    {
      post.image && (
        <figure class="lv-post__cover">
          <Image
            src={post.image}
            widths={[400, 900]}
            sizes="(max-width: 900px) 100vw, 900px"
            alt={post?.excerpt || post.title}
            width={900}
            height={506}
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }

    <div class="lv-prose prose prose-lg max-w-none">
      <slot />
    </div>

    <footer class="lv-post__foot">
      {post.tags && post.tags.length > 0 && <PostTags tags={post.tags} title="Topik" />}
      <SocialShare url={url} text={post.title} class="lv-share" />
      <a class="lv-link" href={getBlogPermalink()}>Kembali ke Jurnal</a>
    </footer>
  </div>
</article>

<RelatedPosts post={post} />

<Closing
  title="Mobil Anda punya keluhan serupa?"
  text="Ceritakan ke admin Pitcar. Anda dijelaskan kemungkinan kerusakan dan estimasi biayanya sebelum pengerjaan."
  href={waArtikel}
  label="Konsultasi lewat WhatsApp"
/>
