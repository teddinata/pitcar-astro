---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const namaKategori = (t: string) => { const s = t.replaceAll('-', ' '); return s.charAt(0).toUpperCase() + s.slice(1); };

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class:list={['lv-entry', { 'lv-entry--img': image }]}>
  <div class="lv-entry__body">
    <p class="lv-entry__meta">
      {
        post.category && (
          <a class="lv-entry__cat" href={getPermalink(post.category.slug, 'category')}>
            {namaKategori(post.category.title)}
          </a>
        )
      }
      <time datetime={new Date(post.publishDate).toISOString()}>{getFormattedDate(post.publishDate)}</time>
    </p>
    <h2 class="lv-entry__title">
      {link ? <a href={link}>{post.title}</a> : post.title}
    </h2>
    {post.excerpt && <p class="lv-entry__excerpt">{post.excerpt}</p>}
  </div>
  {
    image && (
      <div class="lv-entry__img">
        <Image
          src={image}
          widths={[400, 900]}
          width={900}
          sizes="(max-width: 767px) 100vw, 320px"
          alt=""
          aspectRatio="16:9"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</article>
