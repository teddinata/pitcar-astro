---
import { APP_BLOG } from 'astrowind:config';

import { getRelatedPosts } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const namaKategori = (t: string) => { const s = t.replaceAll('-', ' '); return s.charAt(0).toUpperCase() + s.slice(1); };

// Scored by shared category first, then shared tags, so posts without tags still get neighbours.
const relatedPosts = APP_BLOG.isRelatedPostsEnabled ? await getRelatedPosts(post, APP_BLOG.relatedPostsCount ?? 4) : [];
---

{
  relatedPosts.length > 0 && (
    <section class="lv-sec lv-sec--seam lv-related" aria-labelledby="terkait-judul">
      <div class="lv-wrap">
        <h2 class="lv-h2" id="terkait-judul">
          Artikel terkait
        </h2>
        <ul class="lv-related__list">
          {relatedPosts.map((p) => (
            <li>
              {p.category && <span class="lv-related__cat">{namaKategori(p.category.title)}</span>}
              <a href={getPermalink(p.permalink, 'post')}>{p.title}</a>
            </li>
          ))}
        </ul>
        <p class="lv-sec__foot">
          <a class="lv-link" href={getBlogPermalink()}>
            Semua artikel
          </a>
        </p>
      </div>
    </section>
  )
}
